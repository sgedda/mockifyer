# Shared Mockifyer lane across all Node services
MOCKIFYER_CLIENT_ID=wanderweird-demo
MOCKIFYER_RUNTIME=filesystem
MOCKIFYER_RECORD=false
# Filesystem hops are posted here so the dashboard Network tab can show them.
# The npm dev scripts set this already; a .env file is not loaded by the services.
MOCKIFYER_DASHBOARD_URL=http://127.0.0.1:3002

# Service URLs
GATEWAY_URL=http://127.0.0.1:4200
AUTH_URL=http://127.0.0.1:4201
TRIPS_URL=http://127.0.0.1:4202
WANDER_URL=http://127.0.0.1:4203
CMS_URL=http://127.0.0.1:4204
LORE_URL=http://127.0.0.1:4205
GRAPHQL_URL=http://127.0.0.1:4206
UMBRACO_URL=http://127.0.0.1:4400

# Optional OpenTripMap (free key: https://opentripmap.io / https://dev.opentripmap.org/register)
# Without this, wander-api serves curated fallback POIs near each destination cousin.
# OPENTRIPMAP_API_KEY=

# Optional Redis proxy
# MOCKIFYER_RUNTIME=proxy
# MOCKIFYER_PROXY_URL=http://127.0.0.1:3002
