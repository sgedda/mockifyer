{
  "name": "@wanderweird/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:hybrid": "EXPO_PUBLIC_MOCKIFYER_BACKEND=hybrid MOCKIFYER_MODE=on EXPO_PUBLIC_MOCKIFYER_MODE=on expo start",
    "start:hybrid:record": "EXPO_PUBLIC_MOCKIFYER_BACKEND=hybrid MOCKIFYER_MODE=on EXPO_PUBLIC_MOCKIFYER_MODE=on EXPO_PUBLIC_MOCKIFYER_RECORD=true MOCKIFYER_RECORD=true expo start",
    "start:redis": "EXPO_PUBLIC_MOCKIFYER_BACKEND=redis MOCKIFYER_MODE=on EXPO_PUBLIC_MOCKIFYER_MODE=on expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8090",
    "web:demo": "EXPO_PUBLIC_MOCKIFYER_BACKEND=hybrid MOCKIFYER_MODE=off EXPO_PUBLIC_MOCKIFYER_MODE=off expo start --web --port 8090"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/syne": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@sgedda/mockifyer-core": "file:../../../../packages/mockifyer-core",
    "@sgedda/mockifyer-dashboard": "file:../../../../packages/mockifyer-dashboard",
    "@sgedda/mockifyer-fetch": "file:../../../../packages/mockifyer-fetch",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
