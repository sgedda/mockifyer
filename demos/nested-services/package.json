{
  "name": "mockifyer-nested-services-demo",
  "version": "1.0.0",
  "type": "module",
  "description": "Mockifyer nested services demo: BFF calling multiple downstream services with full request tracing",
  "scripts": {
    "dev": "concurrently \"npm run gateway\" \"npm run frontend\" \"npm run dashboard\"",
    "gateway": "node --watch gateway.js",
    "frontend": "vite",
    "dashboard": "mockifyer-dashboard --mock-data ./mock-data --port 3002",
    "record": "node record.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sgedda/mockifyer-core": "^1.10.181",
    "@sgedda/mockifyer-fetch": "^1.8.100",
    "@sgedda/mockifyer-dashboard": "^1.5.93",
    "express": "^4.18.2",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
