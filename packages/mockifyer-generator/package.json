{
  "name": "@sgedda/mockifyer-generator",
  "version": "0.1.0",
  "description": "Browser-safe mock data generator — field-kind inference, seeded offline generation, and edge-case variants for Mockifyer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mockifyer-generate": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "watch": "tsc --watch"
  },
  "keywords": [
    "mock",
    "mockifyer",
    "faker",
    "generator",
    "testing",
    "seeded",
    "variants",
    "chaos"
  ],
  "author": {
    "name": "Sebastian Gedda",
    "url": "https://github.com/sgedda"
  },
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^9.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://mockifyer.dev",
  "bugs": {
    "url": "https://github.com/sgedda/mockifyer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgedda/mockifyer.git",
    "directory": "packages/mockifyer-generator"
  }
}
