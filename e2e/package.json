{
  "name": "mockifyer-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Headless Playwright end-to-end QA for Mockifyer using the WanderWeird demo stack",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:gui": "playwright test --project=gui",
    "test:android": "E2E_ANDROID=1 playwright test --project=android",
    "android:apk": "native/scripts/build-apk.sh --install",
    "android:metro": "native/scripts/metro.sh start",
    "android:metro:warm": "native/scripts/metro.sh warm",
    "android:check-flows": "for f in native/flows/*.yaml; do maestro check-syntax \"$f\" || exit 1; done",
    "artifacts": "tsx scripts/build-run-artifacts.ts",
    "test:main": "MAIN_DASHBOARD_URL=http://127.0.0.1:3012 playwright test tests/main-features.spec.ts",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@playwright/test": "^1.56.0",
    "@sgedda/mockifyer-core": "file:../packages/mockifyer-core",
    "@types/node": "^20.11.24",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "yaml": "^2.9.1"
  }
}
