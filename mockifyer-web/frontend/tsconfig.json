{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases (no baseUrl — removed in TypeScript 7; paths must be relative) */
    "paths": {
      "@/*": ["./src/*"],
      /* Vite aliases sources; tsc needs the same for `tsc && vite build` (Railway). */
      "@sgedda/mockifyer-generator": ["../../packages/mockifyer-generator/src/index.ts"],
      /* When tsc follows the alias into packages/mockifyer-generator/src, resolve
         faker from this frontend install (CI may not have generator/node_modules). */
      "@faker-js/faker": ["./node_modules/@faker-js/faker/dist/index.d.ts"],
      "@faker-js/faker/*": ["./node_modules/@faker-js/faker/dist/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}


